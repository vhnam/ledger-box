---
import { HeroCtas } from '#/components/hero-ctas';
---

<section class="mx-auto max-w-6xl px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="text-center lg:text-left">
      <p class="text-primary text-sm font-semibold tracking-wide uppercase">For the person in the middle</p>
      <h1 class="font-display text-foreground mt-4 text-4xl font-semibold text-balance sm:text-6xl">
        A ledger for money you hold on behalf of other people.
      </h1>
      <p class="text-foreground/70 mx-auto mt-6 max-w-2xl text-lg text-balance sm:text-xl lg:mx-0">
        Most personal finance apps answer "what did I spend it on". Ledger Box answers a different question:
        <span class="text-foreground font-medium">
          how much is in this wallet right now, and can I account for every change to it?
        </span>
      </p>
      <div class="flex justify-center lg:justify-start">
        <HeroCtas />
      </div>
    </div>
    <img
      src="/illustrations/hero-wallet.svg"
      alt=""
      aria-hidden="true"
      width="560"
      height="400"
      class="mx-auto w-full max-w-md object-contain lg:max-w-none"
    />
  </div>
</section>
