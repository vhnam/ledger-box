---
import { Card, CardDescription, CardHeader, CardTitle } from '@vhnam/ui/components/ui/card';

const features = [
  {
    name: 'Wallets',
    description: 'Multiple wallets, each with its own balance, timezone, and members.',
  },
  {
    name: 'Transactions',
    description:
      'Income and expenses with a user-set date, editable and soft-deleted, filtered by period and sorted, with file attachments stored in Cloudflare R2.',
  },
  {
    name: 'Transfers',
    description: 'Move money between two wallets as a linked expense/income pair.',
  },
  {
    name: 'Statements',
    description:
      "Opening balance, running balance per row, closing balance, and period totals, computed in the wallet's timezone. Exportable as CSV.",
  },
  {
    name: 'Statement links',
    description:
      'Share a statement publicly without requiring an account. Links are scoped to one wallet and one period, expire by default, can be revoked at any time, and record when they were last opened.',
  },
  {
    name: 'Members',
    description:
      "Invite people by email as viewer (read-only) or manager (read/write). Invites are sent by email and activate when the invited person signs in.",
  },
  {
    name: 'Activity log',
    description: 'An owner-only record of who changed what, so a balance never moves without a trace.',
  },
];
---

<section id="features" class="border-border border-t">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)] lg:items-end">
      <div>
        <h2 class="font-display text-foreground text-3xl font-semibold sm:text-4xl">Features</h2>
        <p class="text-foreground/70 mt-4 max-w-2xl text-lg">
          Everything is scoped to keeping a balance provable — nothing here is about categorizing spend.
        </p>
      </div>
      <img
        src="/illustrations/features-overview.svg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        width="400"
        height="280"
        class="mx-auto hidden w-full max-w-xs object-contain sm:block lg:mx-0 lg:justify-self-end"
      />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <Card>
            <CardHeader>
              <CardTitle className="text-lg font-semibold">{feature.name}</CardTitle>
              <CardDescription className="leading-relaxed">{feature.description}</CardDescription>
            </CardHeader>
          </Card>
        ))
      }
    </div>
  </div>
</section>
