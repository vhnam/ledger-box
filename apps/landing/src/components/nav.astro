---
import { MobileNav } from '#/components/mobile-nav';
import { NavLinks } from '#/components/nav-links';

const nav = [
  { href: '#situation', label: 'The situation' },
  { href: '#features', label: 'Features' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#design-decisions', label: 'Design decisions' },
];
---

<header class="border-border bg-background/95 sticky top-0 z-50 border-b backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#top" class="font-display text-foreground text-lg font-semibold">Ledger Box</a>

    <NavLinks links={nav} />

    <MobileNav client:load />
  </div>
</header>
